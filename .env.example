# Qdrant (padrões usados por src/vector_db/client.py)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Preencha apenas se o Qdrant exigir autenticação.
QDRANT_API_KEY=
QDRANT_COLLECTION=t20_rules

# Embeddings / LLM
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Dimensão do vetor; deve corresponder ao modelo de embedding.
EMBEDDING_DIMENSION=1536
